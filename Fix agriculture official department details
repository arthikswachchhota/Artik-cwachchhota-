<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>কৃষি মন্ত্রণালয় — আর্থিক স্বচ্ছতা</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="../config.js"></script>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f8f6;
      color: #183b2a;
    }

    header {
      background: #0b6b3a;
      color: white;
      padding: 18px;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 24px;
    }

    header p {
      margin: 6px 0 0;
      font-size: 14px;
    }

    .container {
      max-width: 900px;
      margin: auto;
      padding: 20px;
    }

    .back {
      display: inline-block;
      margin-bottom: 18px;
      color: #0b6b3a;
      text-decoration: none;
      font-weight: bold;
    }

    .search-box {
      background: white;
      padding: 20px;
      border-radius: 16px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      margin-bottom: 20px;
    }

    .search-box h2 {
      margin-top: 0;
    }

    .search-row {
      display: flex;
      gap: 10px;
    }

    input {
      flex: 1;
      padding: 14px;
      border: 1px solid #ccd8d1;
      border-radius: 10px;
      font-size: 16px;
    }

    button {
      border: none;
      background: #0b6b3a;
      color: white;
      padding: 14px 20px;
      border-radius: 10px;
      font-size: 16px;
      cursor: pointer;
    }

    button:hover {
      background: #09572f;
    }

    .result {
      background: white;
      padding: 18px;
      border-radius: 14px;
      margin-top: 12px;
      border-left: 5px solid #0b6b3a;
    }

    .result h3 {
      margin-top: 0;
    }

    .tag {
      display: inline-block;
      background: #e7f5ed;
      color: #0b6b3a;
      padding: 5px 9px;
      border-radius: 20px;
      font-size: 13px;
      margin: 3px 0;
    }

    .empty {
      text-align: center;
      padding: 20px;
      color: #68766e;
    }

    footer {
      margin-top: 40px;
      background: #183b2a;
      color: white;
      text-align: center;
      padding: 20px;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .search-row {
        flex-direction: column;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>🌾 কৃষি মন্ত্রণালয়</h1>
    <p>আর্থিক স্বচ্ছতা — প্রকাশিত তথ্য ও যাচাই</p>
  </header>

  <main class="container">

    <a class="back" href="../index.html">
      ← মূল পেজে ফিরে যান
    </a>

    <section class="search-box">

      <h2>🔎 কৃষি মন্ত্রণালয়ের তথ্য খুঁজুন</h2>

      <p>
        দপ্তর, অধিদপ্তর, কর্মকর্তার নাম বা পদবী দিয়ে অনুসন্ধান করুন।
      </p>

      <div class="search-row">

        <input
          id="agricultureSearch"
          type="search"
          placeholder="যেমন: কৃষি সম্প্রসারণ কর্মকর্তা"
        >

        <button onclick="searchAgriculture()">
          খুঁজুন
        </button>

      </div>

    </section>

    <section id="results">

      <div class="empty">
        অনুসন্ধানের জন্য উপরের ঘরে লিখুন।
      </div>

    </section>

    <section class="search-box">

      <h2>📌 তথ্যের কাঠামো</h2>

      <div class="tag">মন্ত্রণালয়</div>
      <div class="tag">দপ্তর</div>
      <div class="tag">অধিদপ্তর</div>
      <div class="tag">কর্মকর্তা</div>
      <div class="tag">আয়</div>
      <div class="tag">সম্পদ</div>
      <div class="tag">দায়</div>
      <div class="tag">উৎস</div>
      <div class="tag">যাচাই</div>

    </section>

  </main>

  <footer>

    <p>
      আর্থিক স্বচ্ছতা — জনগণের অর্থ, জনগণের জানার অধিকার।
    </p>

    <p>
      ব্যক্তিগত ব্যাংক তথ্য, OTP, PIN, password বা গোপন credentials প্রকাশ করা হবে না।
    </p>

  </footer>

  <script>

    async function searchAgriculture() {

      const input =
        document.getElementById("agricultureSearch");

      const results =
        document.getElementById("results");

      const keyword =
        input.value.trim();

      if (!keyword) {

        results.innerHTML = `
          <div class="empty">
            দয়া করে কিছু লিখে অনুসন্ধান করুন।
          </div>
        `;

        return;
      }

      results.innerHTML = `
        <div class="empty">
          🔎 তথ্য খোঁজা হচ্ছে...
        </div>
      `;

      try {

        const { data: departments, error: departmentError } =
  await supabaseClient
    .from("departments")
    .select("id")
    .eq("ministry_id", 1);

if (departmentError) {
  throw departmentError;
}

const departmentIds = departments.map(d => d.id);

const { data: officials, error: officialsError } =
  await supabaseClient
    .from("officials")
    .select("*")
    .in("department_id", departmentIds)
    .or(
      `name.ilike.%${keyword}%,designation.ilike.%${keyword}%`
    )
    .limit(20);

if (officialsError) {
  throw officialsError;
}

const departmentIdsForOfficials = [
  ...new Set(
    officials
      .map(official => official.department_id)
      .filter(id => id !== null)
  )
];

let departmentsMap = {};

if (departmentIdsForOfficials.length > 0) {

  const { data: departments, error: departmentsError } =
    await supabaseClient
      .from("departments")
      .select("id, name, district, upazila")
      .in("id", departmentIdsForOfficials);

  if (departmentsError) {
    throw departmentsError;
  }

  departmentsMap = Object.fromEntries(
    departments.map(department => [
      department.id,
      department
    ])
  );
}

const data = officials.map(official => ({
  ...official,
  departments:
    departmentsMap[official.department_id] || null
}));
        if (!data || data.length === 0) {

          results.innerHTML = `
            <div class="empty">
              এই নামে কোনো কর্মকর্তা পাওয়া যায়নি।
            </div>
          `;

          return;
        }

        results.innerHTML = data.map(official => `

          <div class="result">

            <h3>
              ${escapeHtml(official.name || "নাম নেই")}
            </h3>

            <p>
  <strong>পদবী:</strong>
  ${escapeHtml(
    official.designation || "তথ্য নেই"
  )}
</p>

<p>
  <strong>দপ্তর:</strong>
  ${escapeHtml(
    official.departments?.name || "তথ্য নেই"
  )}
</p>

<p>
  <strong>জেলা:</strong>
  ${escapeHtml(
    official.departments?.district || "তথ্য নেই"
  )}
</p>

<p>
  <strong>উপজেলা:</strong>
  ${escapeHtml(
    official.departments?.upazila || "তথ্য নেই"
  )}
</p>

<span class="tag">
  কৃষি মন্ত্রণালয়
</span>

          </div>

        `).join("");

      } catch (error) {

        console.error(error);

        results.innerHTML = `
  <div class="empty">
    সমস্যা হয়েছে:<br>
    ${escapeHtml(error.message || String(error))}
  </div>
`;

      }

    }

    function escapeHtml(value) {

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    }

    document
      .getElementById("agricultureSearch")
      .addEventListener(
        "keydown",
        function(event) {

          if (event.key === "Enter") {
            searchAgriculture();
          }

        }
      );

  </script>

</body>
</html>
